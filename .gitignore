# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# uv
.venv/

# Data & model artifacts (these live in S3, not git)
data/
raw/
raw-data/
activations/
checkpoints/
*.ckpt
*.pt
*.pth

# Raw/intermediate results (S3-backed, not versioned)
